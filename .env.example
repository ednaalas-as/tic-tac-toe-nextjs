# Supabase project used for Online Multiplayer.
# Find both values in Supabase Dashboard → Project Settings → API Keys.
# Both are PUBLIC values (safe in the browser). This app never needs the
# service-role / secret key — do not add it here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
